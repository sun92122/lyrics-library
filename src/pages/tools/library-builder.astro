---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { LibraryBuilder } from '@/components/LibraryBuilder';
import { ArrowLeft } from 'lucide-react';

const songEntries = await getCollection('songs');
const availableSongs = songEntries.map((entry) => ({ id: entry.id, ...entry.data }));
---

<Layout title="子歌曲庫建構器 - Lyrics Library" description="視覺化挑選曲目、調整排序並匯出歌庫 JSON 檔案">
  <div class="space-y-6">
    <div>
      <a
        href="/libraries"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-indigo-600 transition-colors"
      >
        <ArrowLeft className="w-4 h-4" />
        <span>返回歌曲庫總覽</span>
      </a>
    </div>

    <LibraryBuilder client:load availableSongs={availableSongs} />
  </div>
</Layout>
