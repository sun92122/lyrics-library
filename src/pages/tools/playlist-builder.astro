---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { PlaylistBuilder } from '@/components/PlaylistBuilder';
import { ArrowLeft } from 'lucide-react';

const songEntries = await getCollection('songs');
const availableSongs = songEntries.map((entry) => ({ id: entry.id, ...entry.data }));
---

<Layout title="敬拜歌單產生器 - Lyrics Library" description="視覺化挑選曲目、配置個別調性與流程排程，即時產出無狀態分享網址">
  <div class="space-y-6">
    <div>
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-indigo-600 transition-colors"
      >
        <ArrowLeft className="w-4 h-4" />
        <span>返回首頁</span>
      </a>
    </div>

    <PlaylistBuilder client:load availableSongs={availableSongs} />
  </div>
</Layout>
