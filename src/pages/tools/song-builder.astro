---
import Layout from "@/layouts/Layout.astro";
import { ArrowLeft } from "lucide-react";

import { SongBuilder } from "@/components/SongBuilder";
---

<Layout
  title="歌詞檔案建立工具 - Lyrics Library"
  description="智慧辨識段落，快速產生合規歌詞 JSON"
>
  <div class="space-y-6">
    <div>
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-indigo-600 transition-colors"
      >
        <ArrowLeft className="w-4 h-4" />
        <span>返回首頁</span>
      </a>
    </div>

    <SongBuilder client:load />
  </div>
</Layout>
