---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { Music, BookOpen, ArrowRight } from 'lucide-react';

const songs = await getCollection('songs');
const libraries = await getCollection('libraries');
---

<Layout title="Lyrics Library - 現代化靜態詩歌歌詞與敬拜管理平台">
  <div class="space-y-12">
    <!-- Hero Banner -->
    <div class="text-center py-8 sm:py-12 space-y-4">
      <h1 class="text-4xl sm:text-5xl font-black text-slate-900 tracking-tight">
        現代化靜態詩歌與敬拜庫
      </h1>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">
        零後端極致效能、精準字元和弦對齊、即時升降調與歌單排程管理
      </p>
    </div>

    <!-- Songs List -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <Music className="w-5 h-5 text-indigo-600" />
          <h2 class="text-2xl font-bold text-slate-900">詩歌總覽 ({songs.length})</h2>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          songs.map((song) => (
            <a
              href={`/songs/${song.id}`}
              class="group p-5 bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md hover:border-indigo-300 transition-all flex flex-col justify-between"
            >
              <div class="space-y-2">
                <div class="font-bold text-lg text-slate-900 group-hover:text-indigo-600 transition-colors">
                  {song.data.meta.title.a}
                  {song.data.meta.title.b && (
                    <span class="text-sm font-normal text-slate-400 block">
                      {song.data.meta.title.b}
                    </span>
                  )}
                </div>

                <div class="flex flex-wrap gap-1.5 pt-1">
                  {song.data.meta.tags.slice(0, 3).map((tag) => (
                    <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 text-xs font-medium">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>

              <div class="flex items-center justify-between pt-4 mt-3 border-t border-slate-100 text-xs text-slate-500">
                <span class="font-mono">原調: {song.data.meta.originalKey ?? '—'}</span>
                <span class="flex items-center gap-1 font-medium text-indigo-600 group-hover:translate-x-0.5 transition-transform">
                  查看歌詞 <ArrowRight className="w-3 h-3" />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Libraries List -->
    <section class="space-y-4">
      <div class="flex items-center gap-2">
        <BookOpen className="w-5 h-5 text-indigo-600" />
        <h2 class="text-2xl font-bold text-slate-900">精選子歌曲庫 ({libraries.length})</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          libraries.map((lib) => (
            <div class="p-6 bg-white rounded-2xl border border-slate-200/80 shadow-sm space-y-3">
              <div>
                <h3 class="font-bold text-lg text-slate-900">
                  {lib.data.meta.title.a}
                  {lib.data.meta.title.b && (
                    <span class="text-sm font-normal text-slate-400 ml-2">
                      ({lib.data.meta.title.b})
                    </span>
                  )}
                </h3>
                {lib.data.meta.description && (
                  <p class="text-sm text-slate-600 mt-1">{lib.data.meta.description}</p>
                )}
              </div>

              <div class="flex items-center justify-between text-xs text-slate-500 pt-2 border-t border-slate-100">
                <span>收錄曲目：{lib.data.songIds.length} 首</span>
                <div class="flex gap-1">
                  {lib.data.meta.tags.map((t) => (
                    <span class="px-2 py-0.5 bg-indigo-50 text-indigo-700 rounded text-[11px]">
                      {t}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
