    "author": "參考經文：詩篇第九十篇\n經文摘編：葉薇心／作曲：王玫"
  },
  "sections": [
    {
      "name": "$V1",
      "lines": [
        {
          "a": "主啊 祢世世代代做我們的居所"
        },
        {
          "a": "眾山未曾生出 地和世界未曾造成"
        },
        {
          "a": "亙古直到永遠 祢是神"
        }
      ]
    },
    {
      "name": "$V2",
      "lines": [
        {
          "a": "主啊 祢看待千年如已過的昨天"
        },
        {
          "a": "又如夜的片刻 祢叫世人歸於塵土"
        },
        {
          "a": "白天生長晚上枯乾"
        }
      ]
    },
    {
      "name": "$C",
      "lines": [
        {
          "a": "求祢指教我們數算自己的日子"
        },
        {
          "a": "使我們得著智慧的心"
        },
        {
          "a": "早晨我們飽嚐祢的慈愛"
        },
        {
          "a": "一生一世 歡呼喜樂"
        }
      ]
    },
    {
      "name": "$B",
      "lines": [
        {
          "a": "誰曉得 祢怒氣的權勢畏懼祢"
        },
        {
          "a": "誰按著 祢該受的敬畏敬畏祢"
        }
      ]
    }
  ]
}
