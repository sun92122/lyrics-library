  "sections": [
    {
      "name": "$V",
      "lines": [
        {
          "a": "祢的愛是永無止盡"
        },
        {
          "a": "主祢四面環繞我"
        },
        {
          "a": "祢的愛使我甦醒"
        },
        {
          "a": "心中喜樂不住滿溢"
        },
        {
          "a": "萬物都向祢呼喊"
        },
        {
          "a": "讓讚美充滿這地"
        }
      ]
    },
    {
      "name": "$PC",
      "lines": [
        {
          "a": "黑暗終究會過去"
        },
        {
          "a": "為愛祢犧牲自己"
        },
        {
          "a": "在祢真光中我得著生命"
        }
      ]
    },
    {
      "name": "$C",
      "lines": [
        {
          "a": "我伸出 大能雙手"
        },
        {
          "a": "釋放祢屬天榮耀"
        },
        {
          "a": "主是何等的奇妙"
        },
        {
          "a": "與祢同行何等美好"
        },
        {
          "a": "讓生命真光照耀"
        }
      ]
    }
  ]
}
