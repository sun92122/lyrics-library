    {
      "name": "$V2",
      "lines": [
        {
          "a": "Would you be whiter, much whiter than snow?",
          "b": "你是否願潔淨白過於雪？"
        },
        {
          "a": "There's power in the blood",
          "b": "寶血有能力"
        },
        {
          "a": "Power in the blood",
          "b": "大有能力"
        },
        {
          "a": "Sin stains are lost in its life-giving flow",
          "b": "到生命泉你脫去眾罪孽"
        },
        {
          "a": "There's wonderful power in the blood",
          "b": "耶穌的寶血有能力"
        }
      ]
    },
    {
      "name": "$V3",
      "lines": [
        {
          "a": "What can wash away my sin?",
          "b": "如何被赦免潔淨？"
        },
        {
          "a": "(Nothing but the blood)",
          "b": "(羔羊寶血裡)"
        },
        {
          "a": "What can make me whole again?",
          "b": "重新得著生命？"
        },
        {
          "a": "(Nothing but the blood)",
          "b": "(羔羊寶血裡)"
        },
        {
          "a": "Nothing but the blood of Christ",
          "b": "在羔羊的寶血裡"
        },
        {
          "a": "God's atoning sacrifice",
          "b": "基督成就馨香的祭"
        },
        {
          "a": "This is all my hope and peace",
          "b": "這是我平安希望"
        },
        {
          "a": "This is all my righteousness",
          "b": "我已因祂得稱義"
        }
