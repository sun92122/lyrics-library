      "name": "$V1",
      "lines": [
        {
          "a": "Would you be free from the burden of sin?",
          "b": "你是否願從罪擔得釋放？"
        },
        {
          "a": "There's power in the blood",
          "b": "寶血有能力"
        },
        {
          "a": "Power in the blood",
          "b": "大有能力"
        },
        {
          "a": "Would you o'er evil a victory win?",
          "b": "你是否願勝過罪惡捆綁？"
        },
        {
          "a": "There's wonderful power in the blood",
          "b": "耶穌的寶血有能力"
        }
      ]
    },
    {
      "name": "$C1",
      "lines": [
        {
