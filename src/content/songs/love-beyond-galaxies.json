      "lines": [
        {
          "a": "神的創造 多麼奇妙"
        },
        {
          "a": "祂的恩典 讓我知道"
        },
        {
          "a": "信心帶路 不再迷惘"
        },
        {
          "a": "十架大愛 指引方向"
        }
      ]
    },
    {
      "name": "$V2",
      "lines": [
        {
          "a": "曠野試煉 讓我剛強"
        },
        {
          "a": "恩雨降臨 滋潤心房"
        },
        {
          "a": "黑夜再深 仍有盼望"
        },
        {
          "a": "恩典真理 伴我歌唱"
        }
      ]
    },
    {
      "name": "$C",
      "lines": [
        {
          "a": "向祂唱新歌 讚美超越星河"
        },
        {
          "a": "彈得巧妙 歌唱快樂"
        },
        {
          "a": "全地齊來 向主歡樂"
