  "sections": [
    {
      "name": "$I",
      "lines": [
        {
          "a": "如今常存的 有信有望有愛"
        },
        {
          "a": "其中最大的是愛"
        }
      ]
    },
    {
      "name": "$V1",
      "lines": [
        {
          "a": "我若能說萬人的方言甚至天使的話"
        },
        {
          "a": "卻沒有愛 卻沒有愛"
        },
        {
          "a": "我就是鳴的鑼響的鈸"
        }
      ]
    },
    {
      "name": "$V2",
      "lines": [
        {
          "a": "我若能像先知講道 明白各樣奧祕"
        },
        {
          "a": "卻沒有愛 卻沒有愛"
        },
        {
          "a": "我就一點也沒有可誇"
        }
      ]
    },
    {
      "name": "$C1",
      "lines": [
        {
          "a": "愛是恆久忍耐 又有恩慈"
        },
        {
          "a": "愛是不嫉妒 不自誇 不張狂"
        },
        {
          "a": "不做害羞的事 不求自己的益處"
        },
        {
          "a": "不計算人的惡 不輕易發怒"
        }
      ]
    },
    {
      "name": "$C2",
      "lines": [
        {
          "a": "愛是喜歡真理 不喜歡不義"
        },
        {
          "a": "愛是凡事相信 凡事忍耐 凡事盼望"
        },
        {
          "a": "愛是永不止息 愛是永不止息"
        },
        {
          "a": "愛是從神而來 因為神就是愛"
        }
      ]
    },
    {
      "name": "$V3",
      "lines": [
        {
          "a": "我若甘願賙濟窮人 性命也不看重"
        },
        {
          "a": "卻沒有愛 卻沒有愛"
        },
        {
          "a": "一切也是無益虛空"
        }
      ]
    }
  ]
}
