  "sections": [
    {
      "name": "$V1",
      "lines": [
        {
          "a": "開我雙眼看見主榮耀",
          "b": "내 눈 주의 영광을 보네"
        },
        {
          "a": "主的寶座在我們中間",
          "b": "우리 가운데 계신 주님"
        },
        {
          "a": "至高神榮耀遍滿全宇宙",
          "b": "그 빛난 영광 온 하늘 덮고"
        },
        {
          "a": "讚美聲充滿在全地",
          "b": "그 찬송 온 땅 가득해"
        }
      ]
    },
    {
      "name": "$V2",
      "lines": [
        {
          "a": "開我雙眼看見主榮耀",
          "b": "내 눈 주의 영광을 보네"
        },
        {
          "a": "主的寶座就在讚美中",
          "b": "찬송 가운데 서신 주님"
        },
        {
          "a": "哦至高全能神已面向全世界",
          "b": "주님의 얼굴은 온 세상 향하네"
        },
        {
          "a": "祂全能雙手已高舉",
          "b": "권능의 팔을 드셨네"
        }
      ]
    },
    {
      "name": "$C",
      "lines": [
        {
          "a": "主的榮耀已充滿 在這裡",
          "b": "주의 영광 이곳에 가득해"
        },
        {
          "a": "呼召我們在此地站立",
          "b": "우린 서네 주님과 함께"
        },
        {
          "a": "讓我們揚聲讚美一同前進",
          "b": "찬양하며 우리는 전진하리"
        },
        {
          "a": "直到列國萬民看見主",
          "b": "모든 열방 주 볼때까지"
        }
      ]
    },
    {
      "name": "$B",
      "lines": [
        {
          "a": "至高全能神求祢來更新我們",
          "b": "하늘 아버지 우릴 새롭게 하사"
        },
        {
          "a": "差遣我們在列邦宣揚祢至聖名",
          "b": "열방 중에서 주를 섬기게 하소서"
        },
        {
          "a": "好讓萬國與萬民 同來敬拜祢",
          "b": "모든 나라 일어나 찬송 부르며"
        },
        {
          "a": "全地都要看見至高神榮耀",
          "b": "영광의 주님을 보게 하소서"
        }
      ]
    },
