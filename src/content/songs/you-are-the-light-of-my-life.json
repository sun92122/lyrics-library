      "lines": [
        {
          "a": "祢是我生命的光",
          "b": "You are the light of my life"
        },
        {
          "a": "讓我為祢不斷綻放",
          "b": "Let me continually shine for You"
        },
        {
          "a": "祢是我天國盼望",
          "b": "You are my hope of heaven"
        },
        {
          "a": "讓我為祢壯膽剛強",
          "b": "Let me be strong and courageous for You"
        }
      ]
    },
