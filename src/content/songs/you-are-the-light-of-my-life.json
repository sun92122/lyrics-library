    {
      "name": "$PC",
      "lines": [
        {
          "a": "歌唱跳舞和讚美 單單因為祢",
          "b": "I sing, dance and praise, only because of You"
        },
        {
          "a": "我肺腑中的氣息 全都出於祢",
          "b": "The breath within me comes entirely from You"
        }
      ]
    },
    {
      "name": "$C",
      "lines": [
        {
          "a": "頌讚榮耀歸於祢",
          "b": "Praise and glory belong to You"
