      "lines": [
        {
          "a": "主我仰望祢 我全然信靠祢",
          "b": "God, I look to You, I won't be overwhelmed"
        },
        {
          "a": "賜我異象 能看見祢心意",
          "b": "Give me vision, To see things like You do"
        },
        {
          "a": "主我仰望祢 我幫助來自祢",
          "b": "God, I look to You, You're where my help comes from"
        },
        {
          "a": "賜我智慧 凡事都在祢手裡",
          "b": "Give me wisdom, You know just what to do"
        }
      ]
    },
    {
      "name": "$C",
      "lines": [
        {
          "a": "我的力量我愛祢",
          "b": "I will love You, Lord, my strength"
        },
        {
          "a": "我的盾牌我愛祢",
          "b": "I will love You, Lord, my shield"
        },
        {
          "a": "我的磐石我愛祢",
          "b": "I will love You, Lord, my rock"
        },
        {
          "a": "從永遠到永遠 我要愛祢主",
          "b": "Forever, all my days, I will love You, God"
        }
      ]
