  "sections": [
    {
      "name": "$V",
      "lines": [
        {
          "a": "就像她 在背後 為祢抹香膏",
          "b": "Seperti wanita mengurapi-Mu"
        },
        {
          "a": "她用眼淚為我主洗腳",
          "b": "Menangis di bawah kaki-Mu"
        },
        {
          "a": "我要這樣愛慕祢 一生都不離棄",
          "b": "Demikian hidupku mau mengasihi-Mu"
        },
        {
          "a": "耶穌我主 祢對我真好",
          "b": "Yesus Engkau baik bagiku"
        }
      ]
    },
    {
      "name": "$C",
      "lines": [
        {
          "a": "直到一天 我閉上我雙眼",
          "b": "Sampai akhir ku menutup mata"
        },
        {
          "a": "我忠心不會變 等祢應許實現",
          "b": "Ku tetap setia menanti janji-Mu"
        },
        {
          "a": "直到那日 我終於得著 生命的冠冕",
          "b": "Sampai kudapatkan mahkota kehidupanku"
        },
        {
          "a": "我忠心不變 服事祢到永遠",
          "b": "Ku tetap setia, 'tuk melayani-Mu"
        }
      ]
    }
  ]
}
