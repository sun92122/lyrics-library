    {
      "name": "$V1",
      "lines": [
        {
          "a": "我是敬拜器皿 尊崇讚美祢",
          "b": "I am an instrument of exaltation"
        },
        {
          "a": "受造為了高舉祢名超乎萬名",
          "b": "And I was born to lift Your name above all names"
        },
        {
          "a": "祢聽萬物宣揚 歌唱的旋律",
          "b": "You hear the melody of all creation"
        },
        {
          "a": "但有首歌只有我能獻上給祢",
          "b": "But there's a song of praise that only I can bring"
        }
      ]
    },
    {
      "name": "$C",
      "lines": [
        {
          "a": "有誰能配得",
          "b": "Who else is worthy"
        },
