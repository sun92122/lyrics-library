        {
          "a": "無人配得 只有祢耶穌",
          "b": "There is no one, only You Jesus"
        }
      ]
    },
    {
      "name": "$V2",
      "lines": [
        {
          "a": "祢是世世代代 永恆的上帝",
          "b": "You are the infinite God of the ages"
        },
        {
          "a": "祢卻選擇我心為祢所在之地",
          "b": "Yet You chose to make my heart Your dwelling place"
        },
        {
          "a": "醫治我的破碎 祢榮耀顯明",
          "b": "You healed my brokenness, showed me Your glory"
        },
        {
          "a": "天使無法像我獻上感恩的心",
          "b": "So I have songs of thanks not even angels sing"
        }
      ]
    },
    {
      "name": "$B",
      "lines": [
        {
          "a": "神羔羊受膏君王",
          "b": "Lamb of God anointed one"
        },
        {
          "a": "昔在今在永在盼望",
          "b": "Who was and is and is to come"
        },
        {
          "a": "坐在榮耀寶座上",
          "b": "Seated on the throne above"
        },
        {
          "a": "聖哉 聖哉",
          "b": "Holy, Holy"
        },
        {
          "a": "公義主流出寶血",
          "b": "Righteous one who shed His blood"
        },
        {
          "a": "天父的愛完全彰顯",
          "b": "To prove to us the Father's love"
        },
        {
