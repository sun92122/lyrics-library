  "sections": [
    {
      "name": "$V1",
      "lines": [
        {
          "a": "我放下自己 來到祢座前"
        },
        {
          "a": "聖靈降下平靜我的心 在祢愛裡"
        },
        {
          "a": "天父祢為我重新得生命"
        },
        {
          "a": "與自己分離 與我更靠近"
        },
        {
          "a": "相遇基督裡"
        }
      ]
    },
    {
      "name": "$C1",
      "lines": [
        {
          "a": "我把自己全人交給祢"
        },
        {
          "a": "全心交給祢"
        },
        {
          "a": "獻上這心靈 誠實敬拜 在祢同在裡"
        },
        {
          "a": "負擔和重擔都交給祢"
        },
        {
          "a": "在祢腳前哭泣"
        },
        {
          "a": "跟隨祢心意 我願意"
        }
      ]
    },
    {
      "name": "$V2",
      "lines": [
        {
          "a": "天父祢同在 使我靈安息"
        },
        {
          "a": "心思和意念都屬於祢 傾聽祢聲音"
        },
        {
          "a": "耶穌來親自帶領我生命"
        },
        {
          "a": "每個決定 每一個腳印"
        },
        {
          "a": "都在基督裡"
        }
      ]
    },
    {
      "name": "$C2",
      "lines": [
        {
          "a": "我把自己全人交給祢"
        },
        {
          "a": "全心交給祢"
        },
        {
          "a": "獻上這心靈 誠實敬拜 在祢同在裡"
        },
        {
          "a": "負擔和重擔都交給祢"
        },
        {
          "a": "在祢腳前哭泣"
        },
        {
          "a": "祢的話語是 我生命"
        },
        {
          "a": "跟隨祢心意 我願意"
        }
      ]
    }
