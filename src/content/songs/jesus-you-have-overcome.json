    {
      "name": "$V",
      "lines": [
        {
          "a": "這世上的苦難"
        },
        {
          "a": "像海浪不曾停止 拍打海岸"
        },
        {
          "a": "人們相聚離散"
        },
        {
          "a": "有沒有一種約定 永遠不更改"
        }
      ]
    },
    {
      "name": "$PC",
      "lines": [
        {
          "a": "誰能告訴我生命的答案"
        },
        {
          "a": "超越了時空的祝福 永遠的愛"
        }
      ]
    },
    {
      "name": "$C",
      "lines": [
        {
          "a": "耶穌祢勝過了世界 勝過了死亡"
        },
        {
          "a": "勝過了黑暗的權勢 坐在父右邊"
        },
        {
          "a": "世界的亮光 榮耀的君王"
        },
        {
          "a": "耶穌 無罪的羔羊"
        },
        {
          "a": "為我走上十字架"
        }
      ]
    },
